FROM exim-vol

# Import environment variable to pass as parameter to make (e.g., to make parallel builds with -j)
ARG MAKE_OPT
ARG GITHUB_MIRROR

# Set up StateAFL
ENV STATEAFL="/home/ubuntu/stateafl"
ENV STATEAFL_CFLAGS="-DBLACKLIST_GLOBALS -DENABLE_TRACE_GLOBAL_DATA -DBLACKLIST_ALLOC_SITES"

COPY --chown=ubuntu:ubuntu stateafl-response-metrics.patch ${WORKDIR}/stateafl-response-metrics.patch

RUN git clone "${GITHUB_MIRROR}https://github.com/stateafl/stateafl.git" $STATEAFL && \
    cd $STATEAFL && \
    git checkout d923e22f7b2688db45b08f3fa3a29a566e7ff3a4 && \
    patch -p1 < ${WORKDIR}/stateafl-response-metrics.patch && \
    make clean all $MAKE_OPT && \
    rm as && \
    cd llvm_mode && CFLAGS="${STATEAFL_CFLAGS}" make $MAKE_OPT && \
    objcopy --redefine-sym queue_size=stateafl_queue_size ${STATEAFL}/afl-llvm-rt-state-tracer.o && \
    objcopy --redefine-sym queue_size=stateafl_queue_size ${STATEAFL}/afl-llvm-rt-state-tracer.o.cpp.o

# Set up environment variables for StateAFL
ENV AFL_PATH=${STATEAFL}
ENV PATH=${STATEAFL}:${PATH}

# Build the same Exim revision, patches, and flags as the AFLNet target,
# changing only the compiler wrapper required by StateAFL.
RUN cd ${WORKDIR} && \
    git clone "${GITHUB_MIRROR}https://github.com/Exim/exim" exim-stateafl && \
    cd exim-stateafl && \
    git checkout d6a5a05b84 && \
    patch -p1 < ${WORKDIR}/exim-response-code.patch && \
    patch -p1 < ${WORKDIR}/exim-rand.patch && \
    patch -p1 < ${WORKDIR}/exim-log-bug.patch && \
    cd src; mkdir Local; cp src/EDITME Local/Makefile && \
    cd Local; patch -p1 < ${WORKDIR}/exim.patch; cd .. && \
    make CFLAGS="-DUSE_OPENSSL=1" LDFLAGS+="-lssl -lcrypto" CC=${STATEAFL}/afl-clang-fast clean all $MAKE_OPT

COPY --chown=ubuntu:ubuntu in-smtp-replay ${WORKDIR}/in-smtp-replay
COPY --chown=ubuntu:ubuntu run-stateafl.sh ${WORKDIR}/run-stateafl
COPY --chown=ubuntu:ubuntu blacklist_global.sh ${WORKDIR}/blacklist_global.sh
COPY --chown=ubuntu:ubuntu blacklist_alloc.sh ${WORKDIR}/blacklist_alloc.sh

COPY --chown=ubuntu:ubuntu clean.sh ${WORKDIR}/clean
