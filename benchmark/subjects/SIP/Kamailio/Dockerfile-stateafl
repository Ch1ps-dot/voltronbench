FROM kamailio-vol

# Use ubuntu as default username
USER ubuntu
WORKDIR /home/ubuntu

# Import environment variable to pass as parameter to make (e.g., to make parallel builds with -j)
ARG MAKE_OPT
ARG GITHUB_MIRROR

# Set up StateAFL
ENV STATEAFL="/home/ubuntu/stateafl"
ENV STATEAFL_CFLAGS="-DBLACKLIST_ALLOC_SITES"

COPY --chown=ubuntu:ubuntu stateafl-response-metrics.patch ${WORKDIR}/stateafl-response-metrics.patch

RUN git clone "${GITHUB_MIRROR}https://github.com/stateafl/stateafl.git" $STATEAFL && \
    cd $STATEAFL && \
    git checkout d923e22f7b2688db45b08f3fa3a29a566e7ff3a4 && \
    patch -p1 < ${WORKDIR}/stateafl-response-metrics.patch && \
    make clean all $MAKE_OPT && \
    rm as && \
    cd llvm_mode && CFLAGS="${STATEAFL_CFLAGS}" make $MAKE_OPT

# Set up environment variables for StateAFL
ENV AFL_PATH=${STATEAFL}
ENV PATH=${STATEAFL}:${PATH}

# Dedicated instrumented version for StateAFL
RUN cd $WORKDIR && \
    KAMAILIO_MODULES="kex corex tm tmx sl rr pv maxfwd usrloc registrar textops siputils xlog sanity counters" && \
    git clone "${GITHUB_MIRROR}https://github.com/kamailio/kamailio.git" kamailio-stateafl && \
    cd kamailio-stateafl && \
    git checkout a2209018fb03d && \
    patch -p1 < $WORKDIR/kamailio.patch && \
    CC=${STATEAFL}/afl-clang-fast make MEMPKG=sys cfg && \
    KAMAILIO_MODULE_PATHS="$(printf ' modules/%s' $KAMAILIO_MODULES)" && \
    printf '%s\n' \
        '# this file is generated by the VoltronBench StateAFL Dockerfile' \
        'modules_dirs:=modules' \
        "modules:=$KAMAILIO_MODULE_PATHS" \
        'modules_configured:=1' \
        > src/modules.lst && \
    CC=${STATEAFL}/afl-clang-fast make all $MAKE_OPT

COPY --chown=ubuntu:ubuntu in-sip-replay ${WORKDIR}/in-sip-replay
COPY --chown=ubuntu:ubuntu run-stateafl.sh ${WORKDIR}/run-stateafl
